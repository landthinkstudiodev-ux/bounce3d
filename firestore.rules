rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isValidUserProfile(data) {
      return data.keys().hasAll(['uid', 'displayName', 'isAnonymous']) &&
             data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'isAnonymous', 'updatedAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
             data.isAnonymous is bool &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidLeaderboardScore(data) {
      return data.keys().hasAll(['uid', 'displayName', 'score', 'levelReached']) &&
             data.keys().hasOnly(['uid', 'displayName', 'photoURL', 'score', 'levelReached', 'updatedAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
             data.score is int && data.score >= 0 && data.score <= 10000000 &&
             data.levelReached is int && data.levelReached >= 1 && data.levelReached <= 11 &&
             (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 512));
    }

    function isValidSpeedrunRecord(data) {
      return data.keys().hasAll(['uid', 'displayName', 'levelNumber', 'timeSec']) &&
             data.keys().hasOnly(['uid', 'displayName', 'levelNumber', 'timeSec', 'updatedAt']) &&
             data.uid is string && data.uid == request.auth.uid &&
             data.displayName is string && data.displayName.size() > 0 && data.displayName.size() <= 64 &&
             data.levelNumber is int && data.levelNumber >= 1 && data.levelNumber <= 11 &&
             (data.timeSec is int || data.timeSec is float) && data.timeSec >= 1.0 && data.timeSec <= 3600.0;
    }

    // User profile documents
    match /users/{userId} {
      allow read: if isSignedIn() && request.auth.uid == userId;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidUserProfile(incoming());
      allow delete: if false;
    }

    // Global High Scores leaderboard (Publicly visible to all players)
    match /leaderboard_scores/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == userId && isValidId(userId) && isValidLeaderboardScore(incoming());
      allow delete: if false;
    }

    // Speedrun Records per stage (Publicly visible to all players)
    match /leaderboard_speedruns/{recordId} {
      allow read: if true;
      allow create, update: if isSignedIn() && request.auth.uid == incoming().uid && isValidId(recordId) && isValidSpeedrunRecord(incoming());
      allow delete: if false;
    }
  }
}
